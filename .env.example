# Stable operator-chosen Agent Index id. This is not a Plow credential.
AGENT_ID=galahad-hackathon

# Host path to the Plow credential, mounted read-only into the container.
# Point this outside the repository when the checkout lives on a filesystem
# that cannot hold POSIX modes, so the token is not world-readable.
PLOW_CREDENTIALS_PATH=./plow-credentials
